# ====================================================
# Razorpay Configuration (Get keys from Razorpay Dashboard)
# ====================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ====================================================
# Email Provider Configuration (Choose One)
# ====================================================

# OPTION 1: Custom SMTP / Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Budcast VIP <support@budcast.live>

# OPTION 2: Resend (https://resend.com)
# RESEND_API_KEY=
# FROM_EMAIL=Budcast <onboarding@resend.dev>

# OPTION 3: Brevo (https://www.brevo.com)
# BREVO_API_KEY=

# ====================================================
# Server Configuration
# ====================================================
PORT=4000
NODE_ENV=production
